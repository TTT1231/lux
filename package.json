{
   "name": "@luxkit/cli",
   "version": "1.1.46",
   "description": "One-click project formatting & VSCode config CLI",
   "type": "module",
   "bin": {
      "lux": "dist/index.js"
   },
   "files": [
      "dist",
      "README.md",
      "CHANGELOG.md"
   ],
   "publishConfig": {
      "access": "public"
   },
   "scripts": {
      "build": "tsup && node scripts/copy-assets.mjs",
      "dev": "tsup --watch",
      "lint": "eslint . --cache --cache-location node_modules/.cache/eslint && cspell --cache --cache-location node_modules/.cache/cspell --gitignore \"src/**/*\" && tsc --noEmit",
      "lint:fix": "eslint . --cache --cache-location node_modules/.cache/eslint --fix",
      "format": "prettier --write \"src/**/*.{ts,js,json}\"",
      "worktrees": "node scripts/sync-workspace.mjs",
      "test": "vitest run",
      "test:watch": "vitest",
      "test:coverage": "vitest run --coverage",
      "prepublishOnly": "cross-env NODE_ENV=production bun run build",
      "prepare": "husky"
   },
   "keywords": [
      "cli",
      "cli-lint",
      "agent-lint",
      "custom-lint",
      "eslint",
      "prettier",
      "stylelint",
      "cspell",
      "husky",
      "lint-staged"
   ],
   "author": "TTT1231",
   "license": "ISC",
   "dependencies": {
      "@clack/prompts": "^1.4.0",
      "chalk": "5",
      "commander": "^14.0.3"
   },
   "lint-staged": {
      "src/**/*.{ts,js,json}": [
         "eslint --fix",
         "prettier --write"
      ]
   },
   "devDependencies": {
      "@eslint/js": "10.0.1",
      "@types/node": "^25.5.2",
      "@vitest/coverage-v8": "^4.1.3",
      "cross-env": "^10.1.0",
      "cspell": "10.0.0",
      "eslint": "10.2.0",
      "eslint-config-prettier": "10.1.8",
      "eslint-plugin-prettier": "5.5.5",
      "husky": "^9.1.7",
      "lint-staged": "^17.0.4",
      "prettier": "3.8.1",
      "tsup": "^8.5.1",
      "typescript": "^6.0.2",
      "typescript-eslint": "8.58.0",
      "vitest": "^4.1.3"
   }
}
